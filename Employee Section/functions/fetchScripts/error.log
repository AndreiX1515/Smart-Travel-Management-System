        f.returnDepartureDate AS End,
        f.employeeId AS flight_employeeId,

        -- TeamOP (employee full name)
        COALESCE(
            TRIM(CONCAT(
                IFNULL(e.lName, ''),
                CASE WHEN e.lName IS NOT NULL AND e.lName != '' THEN ', ' ELSE '' END,
                IFNULL(e.fName, ''),
                CASE 
                    WHEN e.mName IS NOT NULL AND e.mName != '' AND e.fName IS NOT NULL 
                    THEN CONCAT(' ', LEFT(e.mName, 1), '.') 
                    ELSE '' 
                END
            )),
            'N/A'
        ) AS TeamOP,

        -- Employee color code
        COALESCE(e.colorCode, '#f0f0f0') AS colorCode,

        f.availSeats AS FlightSeat, 

        -- Available seats
        GREATEST(f.availSeats - IFNULL(cb.total_pax, 0), 0) AS AvailSeats,

        -- Overbooked seats
        CASE 
            WHEN (f.availSeats - IFNULL(cb.total_pax, 0)) < 0 
            THEN ABS(f.availSeats - IFNULL(cb.total_pax, 0))
            ELSE 0 
        END AS AdditionalSeats,

